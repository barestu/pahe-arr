# Copy to .env on the server and set a password before starting Compose.
PAHE_PASSWORD=

# Host folders, relative to the repository or absolute paths on your server.
PAHE_HOST_CONFIG_DIR=./data/config
PAHE_HOST_DOWNLOAD_DIR=./data/downloads
PUID=1000
PGID=1000
TZ=UTC

# Optional first-run values; configure these in web Settings instead if preferred.
PAHE_DOMAIN=
FLARESOLVERR_URL=
