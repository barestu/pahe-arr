# Normalize text so LF/CRLF differences do not become content changes.
* text=auto

# Keep source, configuration, and shell scripts consistent across platforms.
*.go text eol=lf
*.mod text eol=lf
*.sum text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
.env* text eol=lf
.gitignore text eol=lf
.dockerignore text eol=lf
.gitattributes text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf
